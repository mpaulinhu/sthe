# Credenciais do Firebase (Console → Configurações do projeto → Seus apps → Web).
# Copie este arquivo para `.env` e preencha com os valores do seu projeto.
#
# Estas chaves não são segredo: elas vão no bundle que roda no navegador de
# qualquer forma. Quem protege os dados são as Security Rules (firestore.rules)
# somadas ao login — não o sigilo destas linhas.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
