rules_version = '2';

// Regras do STHE.
//
// O banco inteiro é de um negócio só, compartilhado entre poucas pessoas de
// confiança (a dona e quem ela autorizar). Por isso não há isolamento por
// usuário: todo mundo autorizado vê os mesmos dados. O que protege é a lista
// `autorizados` — estar logado NÃO basta, o uid precisa estar lá dentro.
//
// Essa lista só pode ser editada pelo Console do Firebase (nenhuma regra
// permite escrita nela), para ninguém conseguir se auto-autorizar pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/autorizados/$(request.auth.uid));
    }

    // Um documento por registro: cada pessoa, lançamento, item de agenda,
    // recibo e participação de mês tem o seu.
    match /people/{id}           { allow read, write: if autorizado(); }
    match /entries/{id}          { allow read, write: if autorizado(); }
    match /agenda/{id}           { allow read, write: if autorizado(); }
    match /recibos/{id}          { allow read, write: if autorizado(); }
    match /monthMemberships/{id} { allow read, write: if autorizado(); }

    // Dados de quem paga: registro único.
    match /config/{id}           { allow read, write: if autorizado(); }

    // Formato antigo (uma lista por documento). Mantido só para a migração
    // conseguir ler e apagar o que ficou para trás.
    match /sthe/{id}             { allow read, write: if autorizado(); }

    // Lista de quem pode entrar. Leitura só para conferir a própria entrada;
    // escrita bloqueada para todos — só pelo Console.
    match /autorizados/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Qualquer outro caminho é negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
