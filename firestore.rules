rules_version = '2';

// Regras do STHE.
//
// O banco inteiro é de um negócio só, compartilhado entre poucas pessoas de
// confiança (a dona e quem ela autorizar). Por isso não há isolamento por
// usuário: todo mundo autorizado vê os mesmos dados. O que protege é a lista
// `autorizados` — estar logado NÃO basta, o uid precisa estar lá dentro.
//
// Essa lista só pode ser editada por quem já está nela — pela tela de Acessos
// do app ou pelo Console do Firebase. Ninguém se auto-autoriza: criar conta no
// Authentication é livre (o app é público), mas não dá acesso a nada sozinho.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/autorizados/$(request.auth.uid));
    }

    // Um documento por registro: cada pessoa, lançamento, item de agenda,
    // recibo e participação de mês tem o seu.
    match /people/{id}           { allow read, write: if autorizado(); }
    match /entries/{id}          { allow read, write: if autorizado(); }
    match /agenda/{id}           { allow read, write: if autorizado(); }
    match /recibos/{id}          { allow read, write: if autorizado(); }
    match /monthMemberships/{id} { allow read, write: if autorizado(); }

    // Dados de quem paga: registro único.
    match /config/{id}           { allow read, write: if autorizado(); }

    // Formato antigo (uma lista por documento). Mantido só para a migração
    // conseguir ler e apagar o que ficou para trás.
    match /sthe/{id}             { allow read, write: if autorizado(); }

    // Lista de quem pode entrar.
    //
    // Leitura: quem já está autorizado vê a lista inteira (é a tela de Acessos);
    // quem não está só consegue conferir a própria entrada — é o que o app
    // checa no login para saber se libera ou não.
    //
    // Escrita: só quem JÁ está na lista pode convidar ou remover alguém. Essa
    // condição é a porta de entrada do sistema todo. Qualquer pessoa consegue
    // criar uma conta no Firebase Authentication (o app é público), mas sem
    // conseguir gravar aqui ela fica sem acesso a dado nenhum. Se um dia isso
    // virar `if request.auth != null`, o app inteiro fica aberto a quem achar
    // o endereço.
    match /autorizados/{uid} {
      allow read: if autorizado() || (request.auth != null && request.auth.uid == uid);
      allow write: if autorizado();
    }

    // Qualquer outro caminho é negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
